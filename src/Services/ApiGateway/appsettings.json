{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiKey": "payflow-demo-key",
  "ReverseProxy": {
    "Routes": {
      "ledger-route": {
        "ClusterId": "ledger-cluster",
        "Match": { "Path": "/api/ledger/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ledger" } ]
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": { "Path": "/api/wallet/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/wallet" } ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/payment" } ]
      },
      "funding-route": {
        "ClusterId": "funding-cluster",
        "Match": { "Path": "/api/funding/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/funding" } ]
      },
      "statement-route": {
        "ClusterId": "statement-cluster",
        "Match": { "Path": "/api/statement/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/statement" } ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notification/{**catch-all}" }
      }
    },
    "Clusters": {
      "ledger-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5001/" } }
      },
      "wallet-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5002/" } }
      },
      "payment-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5003/" } }
      },
      "funding-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5004/" } }
      },
      "notification-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5005/" } }
      },
      "statement-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5006/" } }
      }
    }
  }
}
